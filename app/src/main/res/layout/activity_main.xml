<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/shelf_bg"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="54dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingEnd="6dp">

        <TextView
            android:id="@+id/btnSelectAll"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackground"
            android:gravity="center_vertical"
            android:paddingEnd="14dp"
            android:text="全选"
            android:textColor="#FFD9D9DC"
            android:textSize="13sp"
            android:visibility="gone" />

        <ImageButton
            android:id="@+id/btnBackAll"
            style="@style/FlatIcon"
            android:contentDescription="返回全部"
            android:src="@drawable/ic_chevron_left"
            android:tint="#FFE9E9EA"
            android:visibility="gone" />

        <TextView
            android:id="@+id/shelfTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/shelf"
            android:textColor="@color/text_primary"
            android:textSize="21sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnCancelSel"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackground"
            android:gravity="center_vertical"
            android:paddingEnd="14dp"
            android:text="完成"
            android:textColor="#FF9A9AA1"
            android:textSize="13sp"
            android:visibility="gone" />

        <ImageButton
            android:id="@+id/btnViewMode"
            style="@style/FlatIcon"
            android:contentDescription="切换视图"
            android:src="@drawable/ic_view_list" />

        <ImageButton
            android:id="@+id/btnImport"
            style="@style/FlatIcon"
            android:contentDescription="@string/import_epub"
            android:src="@drawable/ic_add" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/bookGrid"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:overScrollMode="never"
            android:paddingStart="14dp"
            android:paddingTop="6dp"
            android:paddingEnd="14dp"
            android:paddingBottom="24dp"
            android:scrollbars="none" />

        <LinearLayout
            android:id="@+id/emptyView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone">

            <ImageView
                android:layout_width="76dp"
                android:layout_height="76dp"
                android:src="@drawable/ic_book_empty" />

            <TextView
                android:id="@+id/tvEmptyTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="@string/empty_title"
                android:textColor="#FF6E6E76"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/tvEmptyHint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="40dp"
                android:layout_marginTop="10dp"
                android:layout_marginEnd="40dp"
                android:gravity="center"
                android:lineSpacingExtra="4dp"
                android:text="把 EPUB 文件导入书架，即可开始阅读\n解析章节、目录与插图，自动记住阅读位置"
                android:textColor="#FF4A4A52"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/btnEmptyImport"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginTop="26dp"
                android:background="@drawable/bg_outline_btn"
                android:gravity="center"
                android:paddingStart="26dp"
                android:paddingEnd="26dp"
                android:text="导入本地书籍"
                android:textColor="@color/accent"
                android:textSize="13sp" />
        </LinearLayout>
    </FrameLayout>

    <LinearLayout
        android:id="@+id/actionBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FF141418"
        android:orientation="horizontal"
        android:paddingTop="8dp"
        android:paddingBottom="6dp"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/barMove"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackground"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingTop="4dp"
            android:paddingBottom="4dp">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_folder"
                android:tint="#FFD9D9DC" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="移动分组"
                android:textColor="#FFB9B9BE"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/barPin"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackground"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingTop="4dp"
            android:paddingBottom="4dp">

            <ImageView
                android:id="@+id/barPinIcon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_pin"
                android:tint="#FFD9D9DC" />

            <TextView
                android:id="@+id/barPinText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="置顶"
                android:textColor="#FFB9B9BE"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/barRename"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackground"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingTop="4dp"
            android:paddingBottom="4dp">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_edit"
                android:tint="#FFD9D9DC" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="重命名"
                android:textColor="#FFB9B9BE"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/barDetail"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackground"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingTop="4dp"
            android:paddingBottom="4dp">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_info"
                android:tint="#FFD9D9DC" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="详情"
                android:textColor="#FFB9B9BE"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/barDelete"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackground"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingTop="4dp"
            android:paddingBottom="4dp">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_trash"
                android:tint="@color/accent" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="删除"
                android:textColor="@color/accent"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
