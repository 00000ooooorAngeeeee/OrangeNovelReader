<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/reader_bg">

    <com.orange.novel.reader.reader.ReaderView
        android:id="@+id/reader"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/reader_bg" />

    <FrameLayout
        android:id="@+id/infoRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:paddingStart="20dp"
        android:paddingTop="2dp"
        android:paddingEnd="20dp"
        android:paddingBottom="6dp">

        <TextView
            android:id="@+id/tvSeekChapter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="start|center_vertical"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#FF8C8C94"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/tvBarChapter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal|center_vertical"
            android:ellipsize="end"
            android:maxEms="10"
            android:maxLines="1"
            android:textColor="#FF8C8C94"
            android:textSize="11sp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end|center_vertical"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
            android:id="@+id/tvSeekPercent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#FF8C8C94"
            android:textSize="11sp" />

            <ImageView
            android:id="@+id/ivBattery"
            android:layout_width="13dp"
            android:layout_height="13dp"
            android:layout_marginStart="10dp"
            android:src="@drawable/ic_battery"
            android:tint="#FF8C8C94" />

            <TextView
            android:id="@+id/tvBattery"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="3dp"
            android:textColor="#FF8C8C94"
            android:textSize="11sp" />
        </LinearLayout>
        </FrameLayout>

    <FrameLayout
        android:id="@+id/panelRoot"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">

        <View
            android:id="@+id/panelScrim"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#70000000"
            android:clickable="true"
            android:focusable="true" />

        <LinearLayout
            android:id="@+id/panelSheet"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_sheet_top"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="14dp"
                android:layout_marginEnd="16dp"
                android:layout_marginBottom="10dp"
                android:background="@drawable/bg_card_panel"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingTop="12dp"
                android:paddingEnd="12dp"
                android:paddingBottom="12dp">

                <ImageView
                    android:id="@+id/ivPanelCover"
                    android:layout_width="56dp"
                    android:layout_height="76dp"
                    android:background="@drawable/bg_cover"
                    android:clipToOutline="true"
                    android:scaleType="centerCrop" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvPanelBook"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="2"
                        android:textColor="#FFF0F0F2"
                        android:textSize="17sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvPanelAuthor"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textColor="#FF9C9CA4"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/tvPanelCount"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textColor="#FF6A6A72"
                        android:textSize="11sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/btnSearchAll"
                    android:layout_width="wrap_content"
                    android:layout_height="30dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_chip_off"
                    android:drawableStart="@drawable/ic_search"
                    android:drawablePadding="4dp"
                    android:gravity="center"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:text="搜全文"
                    android:textColor="#FFC9C9D0"
                    android:textSize="11sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingStart="20dp"
                android:paddingTop="2dp"
                android:paddingEnd="20dp"
                android:paddingBottom="4dp">

                <TextView
                    android:id="@+id/tabDetail"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingEnd="26dp"
                    android:text="详情"
                    android:textColor="#FF9C9CA4"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/tabCatalog"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="目录"
                    android:textColor="#FFFFFFFF"
                    android:textSize="15sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">

                <LinearLayout
                    android:id="@+id/catalogPage"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="16dp"
                        android:paddingTop="4dp"
                        android:paddingEnd="16dp"
                        android:paddingBottom="6dp">

                        <EditText
                            android:id="@+id/etSearch"
                            android:layout_width="0dp"
                            android:layout_height="36dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_search"
                            android:hint="搜索章节名 / 章号"
                            android:imeOptions="actionSearch"
                            android:inputType="text"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp"
                            android:singleLine="true"
                            android:textColor="#FFE4E4E7"
                            android:textColorHint="#FF6A6A72"
                            android:textSize="12.5sp" />

                        <TextView
                            android:id="@+id/chipVolume"
                            android:layout_width="wrap_content"
                            android:layout_height="32dp"
                            android:background="?attr/selectableItemBackground"
                            android:drawableEnd="@drawable/ic_chevron_down"
                            android:drawablePadding="1dp"
                            android:drawableTint="#FF8C8C94"
                            android:gravity="center"
                            android:paddingStart="8dp"
                            android:paddingEnd="4dp"
                            android:text="分卷"
                            android:textColor="#FFB0B0B8"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/chipCompact"
                            android:layout_width="wrap_content"
                            android:layout_height="32dp"
                            android:background="?attr/selectableItemBackground"
                            android:drawableEnd="@drawable/ic_chevron_down"
                            android:drawablePadding="1dp"
                            android:drawableTint="#FF8C8C94"
                            android:gravity="center"
                            android:paddingStart="8dp"
                            android:paddingEnd="4dp"
                            android:text="详细"
                            android:textColor="#FFB0B0B8"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/chipOrder"
                            android:layout_width="wrap_content"
                            android:layout_height="32dp"
                            android:background="?attr/selectableItemBackground"
                            android:gravity="center"
                            android:paddingStart="8dp"
                            android:paddingEnd="6dp"
                            android:text="正序"
                            android:textColor="#FFB0B0B8"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1">

                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/chapterList"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:clipToPadding="false"
                            android:paddingTop="4dp"
                            android:paddingBottom="24dp"
                            android:scrollbars="none" />

                        <com.orange.novel.reader.ui.FastScrollBar
                            android:id="@+id/fastScroll"
                            android:layout_width="24dp"
                            android:layout_height="match_parent"
                            android:layout_gravity="end" />
                    </FrameLayout>
                </LinearLayout>

                <ScrollView
                    android:id="@+id/detailPage"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scrollbars="none"
                    android:visibility="gone">

                    <LinearLayout
                        android:id="@+id/detailRows"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />
                </ScrollView>
            </FrameLayout>
        </LinearLayout>
    </FrameLayout>

    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:background="@drawable/bg_top_bar"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingTop="6dp"
        android:paddingEnd="16dp"
        android:paddingBottom="10dp">

        <ImageButton
            android:id="@+id/btnBack"
            style="@style/FlatIcon"
            android:contentDescription="返回"
            android:src="@drawable/ic_back" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvBookName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#FFECECEE"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvChapterName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#FF82828A"
                android:textSize="11sp" />
        </LinearLayout>

        <View
            android:layout_width="48dp"
            android:layout_height="1dp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/bottomBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_bottom_bar"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="14dp"
        android:paddingEnd="20dp"
        android:paddingBottom="12dp">

        <LinearLayout
            android:id="@+id/seekRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnPrevChapter"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:background="?attr/selectableItemBackground"
                android:gravity="center"
                android:paddingStart="2dp"
                android:paddingEnd="12dp"
                android:text="上一章"
                android:textColor="#FFB9B9BE"
                android:textSize="13sp" />

            <SeekBar
                android:id="@+id/seekBar"
                android:layout_width="0dp"
                android:layout_height="26dp"
                android:layout_weight="1"
                android:max="10000"
                android:maxHeight="3dp"
                android:minHeight="3dp"
                android:paddingStart="0dp"
                android:paddingEnd="0dp"
                android:progressBackgroundTint="#FF35353C"
                android:progressTint="@color/accent"
                android:splitTrack="false"
                android:thumb="@drawable/seek_thumb"
                android:thumbOffset="0dp" />

            <TextView
                android:id="@+id/btnNextChapter"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:background="?attr/selectableItemBackground"
                android:gravity="center"
                android:paddingStart="12dp"
                android:paddingEnd="2dp"
                android:text="下一章"
                android:textColor="#FFB9B9BE"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal"
            android:paddingBottom="6dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/btnCatalog"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingStart="10dp"
                    android:paddingTop="5dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="5dp">

                    <ImageView
                        android:id="@+id/ivTabCatalog"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/ic_catalog_outline"
                        android:tint="#FF9C9CA4" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="目录"
                        android:textColor="#FF9C9CA4"
                        android:textSize="11sp" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/btnFontSize"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingStart="10dp"
                    android:paddingTop="5dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="5dp">

                    <ImageView
                        android:id="@+id/ivTabSettings"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/ic_settings_outline"
                        android:tint="#FF9C9CA4" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="设置"
                        android:textColor="#FF9C9CA4"
                        android:textSize="11sp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/fontPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_font_panel"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="6dp"
        android:paddingEnd="20dp"
        android:paddingBottom="10dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="48dp"
                android:layout_height="wrap_content"
                android:text="亮度"
                android:textColor="#FF8C8C94"
                android:textSize="12sp" />

            <SeekBar
                android:id="@+id/seekBrightness"
                android:layout_width="0dp"
                android:layout_height="32dp"
                android:layout_weight="1"
                android:max="100"
                android:maxHeight="3dp"
                android:minHeight="3dp"
                android:paddingStart="0dp"
                android:paddingEnd="0dp"
                android:progressBackgroundTint="#FF35353C"
                android:progressTint="@color/accent"
                android:splitTrack="false"
                android:thumb="@drawable/seek_thumb"
                android:thumbOffset="0dp" />

            <TextView
                android:id="@+id/btnFollowSystem"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:layout_marginStart="14dp"
                android:background="@drawable/bg_chip_off"
                android:gravity="center"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:text="跟随系统"
                android:textColor="#FFB0B0B8"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="48dp"
                android:layout_height="wrap_content"
                android:text="字号"
                android:textColor="#FF8C8C94"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/btnFontMinus"
                android:layout_width="44dp"
                android:layout_height="32dp"
                android:background="@drawable/bg_chip_off"
                android:gravity="center"
                android:text="A-"
                android:textColor="#FFD9D9DC"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tvFontValue"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="19"
                android:textColor="#FFE9E9EA"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/btnFontPlus"
                android:layout_width="44dp"
                android:layout_height="32dp"
                android:background="@drawable/bg_chip_off"
                android:gravity="center"
                android:text="A+"
                android:textColor="#FFD9D9DC"
                android:textSize="14sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/btnSpacing"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="?attr/selectableItemBackground"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="48dp"
                android:layout_height="wrap_content"
                android:text="间距"
                android:textColor="#FF8C8C94"
                android:textSize="12sp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="行距与段距"
                android:textColor="#FFD9D9DC"
                android:textSize="13sp" />

            <ImageView
                android:id="@+id/ivSpacingArrow"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_chevron_down"
                android:tint="#FF7E7E86" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/spacingPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="48dp"
                    android:layout_height="wrap_content"
                    android:text="行距"
                    android:textColor="#FF8C8C94"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/btnLineMinus"
                    android:layout_width="32dp"
                    android:layout_height="30dp"
                    android:background="@drawable/bg_chip_off"
                    android:gravity="center"
                    android:text="−"
                    android:textColor="#FFD9D9DC"
                    android:textSize="16sp" />

                <SeekBar
                    android:id="@+id/seekLine"
                    android:layout_width="0dp"
                    android:layout_height="32dp"
                    android:layout_marginStart="6dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:max="100"
                    android:maxHeight="3dp"
                    android:minHeight="3dp"
                    android:paddingStart="0dp"
                    android:paddingEnd="0dp"
                    android:progressBackgroundTint="#FF35353C"
                    android:progressTint="@color/accent"
                    android:splitTrack="false"
                    android:thumb="@drawable/seek_thumb"
                    android:thumbOffset="0dp" />

                <TextView
                    android:id="@+id/btnLinePlus"
                    android:layout_width="32dp"
                    android:layout_height="30dp"
                    android:background="@drawable/bg_chip_off"
                    android:gravity="center"
                    android:text="+"
                    android:textColor="#FFD9D9DC"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/tvLineValue"
                    android:layout_width="38dp"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:text="1.6"
                    android:textColor="#FFE9E9EA"
                    android:textSize="12sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="48dp"
                    android:layout_height="wrap_content"
                    android:text="段距"
                    android:textColor="#FF8C8C94"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/btnParaMinus"
                    android:layout_width="32dp"
                    android:layout_height="30dp"
                    android:background="@drawable/bg_chip_off"
                    android:gravity="center"
                    android:text="−"
                    android:textColor="#FFD9D9DC"
                    android:textSize="16sp" />

                <SeekBar
                    android:id="@+id/seekPara"
                    android:layout_width="0dp"
                    android:layout_height="32dp"
                    android:layout_marginStart="6dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:max="100"
                    android:maxHeight="3dp"
                    android:minHeight="3dp"
                    android:paddingStart="0dp"
                    android:paddingEnd="0dp"
                    android:progressBackgroundTint="#FF35353C"
                    android:progressTint="@color/accent"
                    android:splitTrack="false"
                    android:thumb="@drawable/seek_thumb"
                    android:thumbOffset="0dp" />

                <TextView
                    android:id="@+id/btnParaPlus"
                    android:layout_width="32dp"
                    android:layout_height="30dp"
                    android:background="@drawable/bg_chip_off"
                    android:gravity="center"
                    android:text="+"
                    android:textColor="#FFD9D9DC"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/tvParaValue"
                    android:layout_width="38dp"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:text="0.7"
                    android:textColor="#FFE9E9EA"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/selBar"
        android:layout_width="wrap_content"
        android:layout_height="42dp"
        android:background="@drawable/bg_sel_bar"
        android:elevation="10dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/btnSelCopy"
            android:layout_width="wrap_content"
            android:layout_height="42dp"
            android:background="?attr/selectableItemBackground"
            android:gravity="center"
            android:paddingStart="22dp"
            android:paddingEnd="22dp"
            android:text="复制"
            android:textColor="#FFE9E9EA"
            android:textSize="13sp" />
    </LinearLayout>
</FrameLayout>
