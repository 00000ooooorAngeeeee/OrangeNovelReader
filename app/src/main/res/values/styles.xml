<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Orange" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@color/shelf_bg</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="colorAccent">@color/accent</item>
        <item name="colorPrimary">@color/shelf_bg</item>
        <item name="colorControlActivated">@color/accent</item>
        <item name="android:colorEdgeEffect">@color/accent</item>
        <item name="alertDialogTheme">@style/Orange.Dialog</item>
        <item name="android:alertDialogTheme">@style/Orange.Dialog</item>
        <item name="android:windowAnimationStyle">@null</item>
    </style>

    <style name="Theme.Orange.Reader" parent="Theme.Orange">
        <item name="android:windowBackground">@color/reader_bg</item>
    </style>

    <style name="Orange.Dialog" parent="Theme.AppCompat.Dialog.Alert">
        <item name="android:windowBackground">@drawable/bg_dialog</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="colorAccent">@color/accent</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:windowMinWidthMajor">72%</item>
        <item name="android:windowMinWidthMinor">86%</item>
    </style>

    <style name="FlatIcon">
        <item name="android:layout_width">44dp</item>
        <item name="android:layout_height">44dp</item>
        <item name="android:background">?attr/selectableItemBackgroundBorderless</item>
        <item name="android:scaleType">center</item>
    </style>
</resources>
